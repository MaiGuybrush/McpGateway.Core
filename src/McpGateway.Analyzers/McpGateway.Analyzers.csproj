<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- ADR-015：不再獨立發布，改由 McpGateway.Core 單一套件合併帶出（analyzers/dotnet/cs） -->
    <IsPackable>false</IsPackable>
    <PackageId>McpGateway.Analyzers</PackageId>
    <Version>0.2.2-preview</Version>
    <Authors>Platform Team</Authors>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);RS2008;CS0618</NoWarn>
    <Description>Roslyn Analyzers and CodeFixes for McpGateway naming standard and schema description validation</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

</Project>
