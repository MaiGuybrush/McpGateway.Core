<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <PackageId>McpGateway.Core</PackageId>
    <Version>0.1.0-preview</Version>
    <Authors>Platform Team</Authors>
    <Company>Internal</Company>
    <Description>MCP Gateway shared library providing authentication, audit, validation, and transport functionality for department gateways (McpGateway.Report, McpGateway.Spc, McpGateway.Qc)</Description>
    <PackageTags>MCP;ModelContextProtocol;Gateway;AI;Tools</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>../../artifacts/packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="9.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <PackageReference Include="prometheus-net" Version="8.2.1" />
    <PackageReference Include="StackExchange.Redis" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- ADR-015：合併打包 Analyzers（免 ProjectReference）。CI 先 build 整個 sln，pack 階段 dll 已存在於 bin -->
    <None Include="..\McpGateway.Analyzers\bin\$(Configuration)\netstandard2.0\McpGateway.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
  </ItemGroup>

</Project>
