{
  "McpGateway": {
    "Department": "__department__",
    "RoutePrefix": "/__department__/mcp",
    "EnableHealthChecks": true,
__AuthSection__,
    "Consul": {
      "Urls": [
        "http://tncimweb1.cminl.oa:8500/",
        "http://tncimweb2.cminl.oa:8500/"
      ]
    },
    "TokenCache": {
      "Type": "Memory",
      "ConnectionString": "localhost:6379",
      "JwtExpirySkewMinutes": 1,
      "ApiKeyTtlMinutes": 5
    },
    "Systems": {
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/mcpgateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:__Port__"
}
